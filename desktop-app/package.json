{
  "name": "desktop-app",
  "version": "1.3.0",
  "description": "ALS Automation Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "node clean.js",
    "build": "npm run clean && electron-builder --win -c.extraMetadata.edition=full -c.artifactName=\"ALS-Full-Setup-${version}.${ext}\"",
    "build:full": "npm run clean && electron-builder --win -c.extraMetadata.edition=full -c.artifactName=\"ALS-Full-Setup-${version}.${ext}\"",
    "build:lite": "npm run clean && electron-builder --win -c.extraMetadata.edition=lite -c.artifactName=\"ALS-Lite-Setup-${version}.${ext}\"",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.als.dashboard",
    "productName": "ALS Automation Engine",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "**/*",
      ".env",
      "!tests/**",
      "!dist/**",
      "!releases/**",
      "!local_cache.json",
      "!local_cache.test-contaminated-backup.json",
      "!local_cache.test-*.json",
      "!implementation_plan.md",
      "!task.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "node-cron": "^4.5.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  }
}
